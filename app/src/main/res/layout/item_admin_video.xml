<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAdminVideo"
    style="@style/Widget.StreamWire.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Thumbnail -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="64dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAdminVideoThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/badge_bg"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_play_circle"
                    app:shapeAppearanceOverlay="@style/Widget.StreamWire.CardView" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_icon"
                    android:padding="5dp"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Video Info & Status Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAdminVideoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:text="Đang hiển thị"
                        android:textColor="@color/accent_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdminVideoId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="ID: #001"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAdminVideoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Chiến Binh Không Gian: Khởi Nguyên"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminVideoMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hành Động • 350K lượt xem"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/divider" />

        <!-- 3 Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminEditVideo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Sửa"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminToggleStatus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:text="Ẩn / Khóa"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_visibility_off"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@color/text_secondary"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminDeleteVideo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Xóa"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@color/accent_red"
                app:strokeColor="@color/divider" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

